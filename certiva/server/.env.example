# ==============================================
# Certiva Server Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ==============================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
# Local example: mongodb://127.0.0.1:27017/certiva
# Atlas example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/certiva
MONGODB_URI=mongodb://127.0.0.1:27017/certiva

# Frontend URL - used to build the verification link embedded in each QR code
CLIENT_URL=http://localhost:5173

# Ascon-128 (Ascon-AEAD128) symmetric master key.
# MUST be exactly 32 hex characters (16 bytes / 128 bits).
# Generate a new one with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ASCON_KEY_HEX=REPLACE_WITH_32_HEX_CHARACTERS

# Directory where the Ed448 key pair (PEM files) is stored.
# Generate the key pair with: npm run generate-keys
ED448_KEYS_DIR=./keys
